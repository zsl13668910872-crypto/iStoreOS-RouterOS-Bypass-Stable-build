#!/bin/sh
# bypass-apply [apply|direct]
#   apply  幂等地应用旁路由基线（IPv4-only、关 flow offloading、OpenClash 基线、DNS 链）
#   direct 回滚：恢复 dnsmasq 直连上游并停止 OpenClash
set -u
log()  { logger -t bypass-apply -- "$*"; echo "$*"; }
uget() { uci -q get "$1" 2>/dev/null || true; }

case "${1:-apply}" in
  apply)
    log "Applying bypass-router baseline..."
    changed_dns=0

    if uci -q get dhcp.lan >/dev/null 2>&1; then
      uci set dhcp.lan.ignore='1'
      uci set dhcp.lan.ra='disabled'
      uci set dhcp.lan.dhcpv6='disabled'
      uci set dhcp.lan.ndp='disabled'
    fi
    for s in $(uci show dhcp 2>/dev/null | sed -n 's/^dhcp\.\([^.=]*\)=odhcpd$/\1/p'); do
      uci set "dhcp.${s}.ra=disabled" 2>/dev/null || true
      uci set "dhcp.${s}.dhcpv6=disabled" 2>/dev/null || true
      uci set "dhcp.${s}.ndp=disabled" 2>/dev/null || true
    done

    # Flow offloading 与 TUN/透明代理叠加时长流易降速
    if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
      uci set firewall.@defaults[0].flow_offloading='0'
      uci set firewall.@defaults[0].flow_offloading_hw='0'
    fi

    if uci -q get openclash.config >/dev/null 2>&1; then
      uci set openclash.config.enable_custom_clash_rules='1' 2>/dev/null || true
      uci set openclash.config.enable_respect_rules='1' 2>/dev/null || true
      uci set openclash.config.enable_redirect_dns='1' 2>/dev/null || true
      uci set openclash.config.en_mode='fake-ip-tun' 2>/dev/null || true
      uci set openclash.config.stack_type='mixed' 2>/dev/null || true
      uci set openclash.config.disable_masq_cache='1' 2>/dev/null || true
      uci set openclash.config.skip_proxy_address='1' 2>/dev/null || true
      uci set openclash.config.ipv6_enable='0' 2>/dev/null || true
    fi

    yaml=''
    for f in /etc/openclash/config/*.yaml /etc/openclash/config/*.yml; do
      [ -s "$f" ] || continue
      [ -z "$yaml" ] && yaml="$f"
    done

    if [ -n "$yaml" ] && uci -q get openclash.config >/dev/null 2>&1 && uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
      cur_srv="$(uget dhcp.@dnsmasq[0].server)"
      cur_nr="$(uget dhcp.@dnsmasq[0].noresolv)"
      cur_cs="$(uget dhcp.@dnsmasq[0].cachesize)"
      if [ "$cur_srv" != "127.0.0.1#1053" ] || [ "$cur_nr" != "1" ] || [ "$cur_cs" != "0" ]; then
        uci set dhcp.@dnsmasq[0].noresolv='1'
        uci -q delete dhcp.@dnsmasq[0].server
        uci add_list dhcp.@dnsmasq[0].server='127.0.0.1#1053'
        # 不缓存 fake-ip 应答：OpenClash 重启后映射会变，dnsmasq 缓存旧值会让连接指向错误域名
        uci set dhcp.@dnsmasq[0].cachesize='0'
        changed_dns=1
      fi
    else
      log "No usable OpenClash YAML yet; keeping normal system DNS to avoid a half-installed DNS outage."
    fi

    uci commit dhcp 2>/dev/null || true
    uci commit firewall 2>/dev/null || true
    uci commit openclash 2>/dev/null || true

    if [ "$changed_dns" -eq 1 ]; then
      /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
      /etc/init.d/openclash enable >/dev/null 2>&1 || true
      /etc/init.d/openclash restart >/dev/null 2>&1 || true
      log "DNS chain enabled: dnsmasq :53 -> OpenClash 127.0.0.1:1053"
    fi
    /etc/init.d/firewall reload >/dev/null 2>&1 || true
    exit 0
    ;;
  direct)
    log "Restoring direct DNS mode (rollback)."
    if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
      uci set dhcp.@dnsmasq[0].noresolv='0'
      uci set dhcp.@dnsmasq[0].cachesize='150'
      uci -q delete dhcp.@dnsmasq[0].server
    fi
    uci commit dhcp 2>/dev/null || true
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
    /etc/init.d/openclash stop >/dev/null 2>&1 || true
    exit 0
    ;;
  *)
    echo "Usage: bypass-apply [apply|direct]"; exit 1 ;;
esac
